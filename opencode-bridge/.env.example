# Copiar a .env y completar. .env NO se versiona (ver .gitignore).

# Autenticacion del puente. Obligatorio. Generar con: openssl rand -hex 32
BRIDGE_TOKEN=

# Publicacion del puerto (host:puerto). Por defecto 0.0.0.0:11444.
BRIDGE_PUBLISH=11444:11444

# Modelo de agy. Vacio = el que tenga agy por defecto. Ver: agy models
AGY_MODEL=
MODEL_NAME=antigravity-session

# Limites
AGY_TIMEOUT=900
MAX_CONCURRENCY=2
MAX_PROMPT_CHARS=300000
DECISION_RETRIES=1

# Texto libre: si es 1, agy corre con --dangerously-skip-permissions (solo modo sin tools).
AGY_SKIP_PERMISSIONS=1

# Chat con memoria (/chat): plan = no ejecuta ni escribe; default = agy puede ejecutar sin pedir permiso.
CHAT_MODE=plan

# Retencion de conversaciones/logs de agy en dias. 0 = no borrar.
AGY_RETENTION_DAYS=7

# Depuracion: guarda el ultimo request en /state/last_request.json (contiene contenido). Dejar en 0.
DEBUG_DUMP_REQUESTS=0

LOG_FORMAT=json

# Alertas opcionales por Telegram (bot de @BotFather). Dejar vacio para desactivar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
